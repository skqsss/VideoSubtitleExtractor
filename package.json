{
  "name": "videosubtitleextractor",
  "version": "0.1.3",
  "description": "粘贴视频链接解析全部可用分辨率并下载原片，本地运行，不经过第三方",
  "author": "local",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "dev:server": "node src/server/index.ts",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:main": "esbuild electron/main.ts --bundle --platform=node --format=esm --target=node20 --external:electron --external:fastify --external:@fastify/static --external:zod --outfile=dist-electron/main.mjs",
    "build:electron": "npm run build && npm run build:main",
    "build:win": "npm run build:electron && electron-builder --win --publish never",
    "build:win:installer": "npm run build:electron && electron-builder --win nsis --publish never",
    "build:win:portable": "npm run build:electron && electron-builder --win portable --publish never",
    "release": "npm test && npm run build:win",
    "electron:start": "npm run build:main && electron .",
    "electron:dev": "npm run build:main && node scripts/electron-dev.mjs",
    "start": "npm run build && node src/server/index.ts",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "npm-run-all2": "^9.0.3",
    "pinia": "^4.0.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
